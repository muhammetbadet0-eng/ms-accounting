rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function ownsEmail(email) {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() == email;
    }
    match /customerAccounts/{email} {
      allow read: if isAdmin() || ownsEmail(email);
      allow create, update, delete: if isAdmin();
    }
    match /paymentRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (signedIn() && resource.data.email == request.auth.token.email.lower());
      allow update, delete: if isAdmin();
    }
    match /appData/{documentId} {
      allow read, write: if isAdmin();
    }
  }
}
